{
  "description": "Salesforce CLI guard: blocks org commands without --target-org and reminds deploy pitfalls",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/claude-code/sf-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/claude-code/sf-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
